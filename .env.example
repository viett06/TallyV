# Run python scripts/init_env.py to create a local .env with generated secrets.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DEMO_USERNAME=hr.demo
DEMO_PASSWORD=replace-with-a-demo-password
DATABASE_URL=postgresql+psycopg://tallyv:replace-with-a-local-database-password@127.0.0.1:54329/tallyv
POSTGRES_PASSWORD=replace-with-a-local-database-password
STORAGE_DIR=./data
# Run python -m scripts.configure_storage to generate local MinIO credentials.
# Existing installations: migrate local files before setting STORAGE_BACKEND=s3.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_DOCKER_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=tallyv-files
S3_PREFIX=tallyv/
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Only used by the optional compose.demo.yaml / native Mailpit demo.
MAILPIT_URL=http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
PROCESSING_MODE=RULE_BASED
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OCR_ENABLED=true
# tesseract: in-process OCR; http: self-hosted OCR service, with no automatic fallback.
OCR_BACKEND=tesseract
OCR_API_URL=http://127.0.0.1:8001
OCR_API_TIMEOUT=30
# Used by Compose API/worker to reach the native OCR service on Docker Desktop.
OCR_DOCKER_API_URL=http://host.docker.internal:8001
SYNC_INTERVAL=30
COOKIE_SECURE=false

# Synthetic MVP through Composio. Keep project keys server-side.
MAIL_PROVIDER=outlook
OUTLOOK_TRANSPORT=composio
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=
# Initial connection and the Sync button always work; background polling is optional.
COMPOSIO_POLL_INTERVAL=0
# Direct Microsoft integration: set OUTLOOK_TRANSPORT=microsoft and supply these credentials.
OUTLOOK_TENANT_ID=common
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/outlook/callback
OUTLOOK_SYNC_DAYS=90
OUTLOOK_TEST_MODE=true

# HTTP HR simulator (not SAP). Compose overrides the URL to http://hr-mock:8010.
HR_MOCK_URL=http://127.0.0.1:8010
# Optional shared service key. If blank, API/worker/simulator derive the same
# isolated demo key from SECRET_KEY. Never send this value to the browser.
HR_MOCK_API_KEY=

# Document Assistant (DraftV module); independent from attendance classification.
ASSISTANT_PROCESSING_MODE=LOCAL_LLM
ASSISTANT_OLLAMA_URL=http://127.0.0.1:11435
ASSISTANT_OLLAMA_MODEL=llama3.2:latest
ASSISTANT_MODEL_TIMEOUT=120
# Bounded data tasks use typed tools and private intermediate snapshots.
ASSISTANT_MAX_DATA_ROWS=10000
ASSISTANT_MAX_STEPS=20
ASSISTANT_MAX_MODEL_CALLS=12
ASSISTANT_MAX_TASK_SECONDS=900
# Docker reaches the separately started local Ollama through this endpoint.
ASSISTANT_DOCKER_OLLAMA_URL=http://host.docker.internal:11435
