# Run python scripts/init_env.py to create a local .env with generated secrets.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DEMO_USERNAME=hr.demo
DEMO_PASSWORD=replace-with-a-demo-password
DATABASE_URL=postgresql+psycopg://tallyv:replace-with-a-local-database-password@127.0.0.1:54329/tallyv
POSTGRES_PASSWORD=replace-with-a-local-database-password
STORAGE_DIR=./data
MAILPIT_URL=http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
PROCESSING_MODE=RULE_BASED
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OCR_ENABLED=true
SYNC_INTERVAL=30
COOKIE_SECURE=false

# Synthetic MVP through Composio. Keep project keys server-side.
MAIL_PROVIDER=outlook
OUTLOOK_TRANSPORT=composio
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=
# Initial connection and the Sync button always work; background polling is optional.
COMPOSIO_POLL_INTERVAL=0
# Direct Microsoft integration: set OUTLOOK_TRANSPORT=microsoft and supply these credentials.
OUTLOOK_TENANT_ID=common
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/outlook/callback
OUTLOOK_SYNC_DAYS=90
OUTLOOK_TEST_MODE=true
